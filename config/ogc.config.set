# Globally required OGC options layered on top of all configs

# Link in modules that should remain available even after an update
CONFIG_USB_STORAGE=y

# Link in modules required to boot the vast majority of PCs
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y

# Enable AMD TPUs

# Reporting
CONFIG_DRM_PANIC_SCREEN_QR_CODE_URL="https://github.com/OpenGamingCollective/linux/issues"

# Gaming

# ASUS Laptops
CONFIG_ASUS_LAPTOP=m
CONFIG_ASUS_WIRELESS=m
CONFIG_ASUS_ARMOURY=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_TF103C_DOCK=m

# ASUS Ally
CONFIG_HID_ASUS=m
CONFIG_HID_ASUS_ALLY=m

# Legion GO
CONFIG_HID_LENOVO=m
CONFIG_HID_LENOVO_GO=m
CONFIG_HID_LENOVO_GO_S=m
CONFIG_LENOVO_WMI_CAPDATA=m

# MSI Claw
CONFIG_HID_MSI=m
CONFIG_MSI_WMI_PLATFORM=m

# Ayaneo
CONFIG_AYN_EC=m
CONFIG_AYANEO_EC=m
CONFIG_HID_AYANEO=m

# OneXPlayer

# ASUS Ally & Legion GO Gyro
CONFIG_IIO_SYSFS_TRIGGER=m
CONFIG_IIO_HRTIMER_TRIGGER=m

# GPD Win
CONFIG_HID_GPD=m

# Steam Deck
CONFIG_MFD_STEAMDECK=m
CONFIG_SENSORS_STEAMDECK=m
CONFIG_LEDS_STEAMDECK=m
CONFIG_EXTCON_STEAMDECK=m
CONFIG_DRM_AMD_COLOR_STEAMDECK=y
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_ULPI=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_PCI=m
CONFIG_USB_DWC3_HAPS=m
CONFIG_USB_DWC2=m
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_DWC2_PCI=m
CONFIG_USB_CHIPIDEA=m
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_PCI=m
CONFIG_USB_CHIPIDEA_MSM=m
CONFIG_USB_CHIPIDEA_GENERIC=m
CONFIG_USB_ISP1760=m
CONFIG_USB_ISP1760_HCD=y
CONFIG_USB_ISP1761_UDC=y
CONFIG_USB_ISP1760_DUAL_ROLE=y
CONFIG_USB_GADGET=m
CONFIG_USB_GADGET_VBUS_DRAW=2
CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=2
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SPI=y
CONFIG_SND_SOC_AMD_SOF_MACH=m
CONFIG_SND_SOC_AMD_MACH_COMMON=m
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_PROBE_WORK_QUEUE=y
CONFIG_SND_SOC_SOF_IPC3=y
CONFIG_SND_SOC_SOF_INTEL_IPC4=y
CONFIG_SND_SOC_SOF_AMD_COMMON=m
CONFIG_SND_SOC_SOF_AMD_ACP63=m
CONFIG_SND_SOC_TOPOLOGY=y

# Zotac Zone
CONFIG_ZOTAC_ZONE_HID=m

# Steam Machine

# Framework Laptops/Desktop
CONFIG_CROS_EC_LIGHTBAR=m
CONFIG_CROS_EC_LPC=m
CONFIG_CROS_EC_MKBP_PROXIMITY=m
CONFIG_CROS_EC_PROTO=m
CONFIG_CROS_EC_RPMSG=m
CONFIG_CROS_EC_SENSORHUB=m
CONFIG_CROS_EC_SPI=m
CONFIG_CROS_EC_SYSFS=m
CONFIG_CROS_EC_TYPEC=m
CONFIG_CROS_EC_UART=m
CONFIG_CROS_EC_UCSI=m
CONFIG_CROS_EC_WATCHDOG=m
CONFIG_CROS_HPS_I2C=m
CONFIG_CROS_KBD_LED_BACKLIGHT=m
CONFIG_CROS_KUNIT=m
CONFIG_CROS_KUNIT_EC_PROTO_TEST=m
CONFIG_CROS_TYPEC_SWITCH=m
CONFIG_CROS_USBPD_LOGGER=m
CONFIG_CROS_USBPD_NOTIFY=m
CONFIG_CROSS_MEMORY_ATTACH=y

# Waydroid
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Allow signed kernel modules
CONFIG_IMA=y
CONFIG_IMA_ARCH_POLICY=y
CONFIG_IMA_APPRAISE_MODSIG=y
CONFIG_IMA_SECURE_AND_OR_TRUSTED_BOOT=y

# Enable sched_ext schedulers
CONFIG_BPF=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_ARCH_WANT_DEFAULT_BPF_JIT=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FUNCTION_TRACER=y
CONFIG_IKHEADERS=m
CONFIG_IKCONFIG_PROC=y
CONFIG_IKCONFIG=y
# --- INTEL ARROW LAKE-S HYBRID & CPU OPTIMIZATIONS ---
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_CLASS_EXT=y

# --- LOW-LATENCY DESKTOP TIMERS & PREEMPTION ---
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y

# --- GAMING & STORAGE CORE ---
CONFIG_NTSYNC=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y

# --- REQUIRED BY BAZZITE / BOOTC / SCX (DO NOT DISABLE) ---
CONFIG_BPF_SYSCALL=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SECURITY_SELINUX=y
CONFIG_OVERLAY_FS=y
CONFIG_BTRFS_FS=y

# --- STRIP UNUSED AMD & HANDHELD HARDWARE ---
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_ACCEL_AMDXDNA=n
CONFIG_HSA_AMD=n
CONFIG_X86_AMD_PSTATE=n
CONFIG_KVM_AMD=n
CONFIG_AMD_IOMMU=n
CONFIG_SND_SOC_AW87XXX=n
CONFIG_HID_OXP=n
CONFIG_LEDS_VALVE=n
CONFIG_CEC_CROS_EC=n
CONFIG_CROS_EC=n
CONFIG_CROS_EC_CHARDEV=n
CONFIG_CROS_EC_I2C=n
