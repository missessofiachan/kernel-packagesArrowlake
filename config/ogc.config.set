# Globally required OGC options layered on top of all configs
# Custom Profile: Intel Core Ultra 7 265K (Arrow Lake-S) | 32GB DDR5-6000 | RTX 4080 Super | 3x Samsung 990/980 PRO NVMe

# --- CORE BOOT & FILESYSTEMS ---
CONFIG_USB_STORAGE=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y

# --- REPORTING ---
CONFIG_DRM_PANIC_SCREEN_QR_CODE_URL="https://github.com/OpenGamingCollective/linux/issues"

# --- INTEL CORE ULTRA 7 265K (ARROW LAKE-S) HYBRID ARCHITECTURE ---
# P-State, Thread Director (HFI), ITMT Turbo 3.0, and Skymont 4-core L2 Cluster scheduling
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_KVM_INTEL=m
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_SENSORS_CORETEMP=m

# Intel Arrow Lake-S Built-in NPU & iGPU (QuickSync Video Encode/Decode)
CONFIG_DRM_ACCEL_IVPU=m
CONFIG_DRM_XE=m
CONFIG_DRM_I915=m
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_PROBE_WORK_QUEUE=y
CONFIG_SND_SOC_SOF_IPC3=y
CONFIG_SND_SOC_SOF_INTEL_IPC4=y
CONFIG_SND_SOC_TOPOLOGY=y

# --- 32GB DDR5-6000 MEMORY & CACHE OPTIMIZATION ---
# Multi-Gen LRU (MGLRU) & madvise Transparent Hugepages to prevent frame-time stalls
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_COMPACTION=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y

# --- NVIDIA RTX 4080 SUPER (OPEN KERNEL MODULE & WAYLAND/HDR HOOKS) ---
# Disable Nouveau so it never conflicts with akmod-nvidia-open; enable HMM/DMA-BUF
CONFIG_DRM_NOUVEAU=n
CONFIG_ZONE_DEVICE=y
CONFIG_HMM_MIRROR=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# --- 3x SAMSUNG 990 / 980 PRO PCIe 4.0 NVMe STORAGE ---
# Built-in NVMe core, multi-queue writeback throttling, io_uring, and NVMe temperature sensors
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_IO_URING=y

# --- GAMING & LOW-LATENCY 1000Hz DESKTOP TIMERS ---
# Built-in NTSYNC so /dev/ntsync is active at boot without modprobe
CONFIG_NTSYNC=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y

# --- WAYDROID & SECURITY / SIGNED MODULES (OGC DEFAULTS) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_IMA=y
CONFIG_IMA_ARCH_POLICY=y
CONFIG_IMA_APPRAISE_MODSIG=y
CONFIG_IMA_SECURE_AND_OR_TRUSTED_BOOT=y
CONFIG_SECURITY_SELINUX=y

# --- BAZZITE / BOOTC / SCHED_EXT (eBPF & BTF REQUIRED) ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_ARCH_WANT_DEFAULT_BPF_JIT=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FUNCTION_TRACER=y
CONFIG_IKHEADERS=m
CONFIG_IKCONFIG_PROC=y
CONFIG_IKCONFIG=y

# --- STRIP UNUSED AMD, CHROMEBOOK EC, AND HANDHELD BLOAT ---
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMD_COLOR_STEAMDECK=n
CONFIG_DRM_ACCEL_AMDXDNA=n
CONFIG_HSA_AMD=n
CONFIG_X86_AMD_PSTATE=n
CONFIG_KVM_AMD=n
CONFIG_AMD_IOMMU=n
CONFIG_SND_SOC_AMD_ACP_COMMON=n
CONFIG_SND_SOC_AMD_SOF_MACH=n
CONFIG_SND_SOC_AMD_MACH_COMMON=n
CONFIG_SND_SOC_SOF_AMD_COMMON=n
CONFIG_SND_SOC_SOF_AMD_ACP63=n
CONFIG_SND_SOC_AW87XXX=n
CONFIG_MFD_STEAMDECK=n
CONFIG_SENSORS_STEAMDECK=n
CONFIG_LEDS_STEAMDECK=n
CONFIG_EXTCON_STEAMDECK=n
CONFIG_LEDS_VALVE=n
CONFIG_HID_ASUS_ALLY=n
CONFIG_HID_LENOVO_GO=n
CONFIG_HID_LENOVO_GO_S=n
CONFIG_AYN_EC=n
CONFIG_AYANEO_EC=n
CONFIG_HID_AYANEO=n
CONFIG_HID_OXP=n
CONFIG_HID_GPD=n
CONFIG_ZOTAC_ZONE_HID=n
CONFIG_CEC_CROS_EC=n
CONFIG_CROS_EC=n
CONFIG_CROS_EC_CHARDEV=n
CONFIG_CROS_EC_I2C=n
CONFIG_CROS_EC_LIGHTBAR=n
CONFIG_CROS_EC_LPC=n
